{
  "name": "@yuna/dsh-tool-fs-search-fast",
  "description": "Fast fork of the model-facing filesystem discovery tools (glob, grep): parallel glob walk with nanosecond mtime ordering and artifact-dir pruning, streaming grep that stops at the match cap.",
  "version": "0.2.1-rc.5-fast.1",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conankun/dsh-tool-fs-search-fast.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-output-retention": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "@vscode/ripgrep": "^1.18.0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "build": "node --check lib/index.js",
    "test": "bash test/sandbox.sh",
    "test:app": "node test/run.mjs",
    "asar:selftest": "node tools/asar-pack.mjs --selftest",
    "app:install": "node tools/install.mjs",
    "app:uninstall": "node tools/uninstall.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
